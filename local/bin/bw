#!/bin/bash
#
# Thin wrapper that runs the Bitwarden CLI (`bw`) inside the Bitwarden
# desktop flatpak.

[[ "${XTRACE:-0}" -eq 1 ]] && set -x

readonly __BASHKIT_BIN_BW_SOURCED="true"

# bw(args...)
#
# Runs `bw` via `flatpak run --command=bw com.bitwarden.desktop`, forwarding
# all arguments through untouched.
#
# Globals:
#   None.
# Arguments:
#   $@   Arguments forwarded verbatim to `bw`.
# Outputs:
#   Whatever `bw` writes.
# Returns:
#   The exit status of `bw`.
core::bw() {
  if declare -f log_debug >/dev/null 2>&1; then
    log_debug "Starting ${FUNCNAME[0]}($(IFS=' '; echo "$*"))"
  fi

  local -a flatpak_run_options=(
    "--command=bw"
    "com.bitwarden.desktop"
  )

  flatpak run \
    "${flatpak_run_options[@]}" \
    "$@"
}

if [[ "${__BASHKIT_LIB_CORE_LOGGER_UTILS_SOURCED:-}" != "true" ]]; then
  # shellcheck source=../lib/bashkit/core/logger-utils.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/core/logger-utils.sh"
fi

core::logger_init --name "$(basename "$0"):core::bw()"

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  core::bw "$@"
fi
