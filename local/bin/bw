#!/bin/bash
#
# Thin wrapper that runs the Bitwarden CLI (`bw`) inside the Bitwarden
# desktop flatpak.

# bw(args...)
#
# Runs `bw` via `flatpak run --command=bw com.bitwarden.desktop`, forwarding
# all arguments through untouched.
#
# Globals:
#   None.
# Arguments:
#   $@   Arguments forwarded verbatim to `bw`.
# Outputs:
#   Whatever `bw` writes.
# Returns:
#   The exit status of `bw`.
core::bw() {
  if declare -f log_debug >/dev/null 2>&1; then
    log_debug "Starting ${FUNCNAME[0]}($(IFS=' '; echo "$*"))"
  fi

  local -a flatpak_run_options=(
    "--command=bw"
    "com.bitwarden.desktop"
  )

  flatpak run \
    "${flatpak_run_options[@]}" \
    "$@"
}

# Run as a script, nothing has loaded the bootstrap yet, and the files below
# need its `import`. Sourced, the caller has loaded it already.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # shellcheck source=../lib/bashkit/os/bk-bootstrap.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/os/bk-bootstrap.sh"
fi

# shellcheck source=../lib/bashkit/core/logger-utils.sh
. /dev/null
import core/logger-utils.sh

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if core::bool_is_valid "${XTRACE:-}" \
    && core::bool_is_true "${XTRACE}"; then
    set -x
  fi

  core::logger_init --name "$(basename "$0"):core::bw()"
  core::bw "$@"
fi
