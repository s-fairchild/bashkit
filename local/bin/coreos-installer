#!/bin/bash
#
# Standalone wrapper executable that runs coreos-installer in a container
# (quay.io/coreos/coreos-installer:release), forwarding options via getopts
# and remaining arguments straight through to the containerized binary.

readonly __BASHKIT_BIN_COREOS_INSTALLER_SOURCED="true"

# core::usage_coreos-installer()
#
# Prints usage to stderr.
#
# Globals:
#   None.
# Arguments:
#   None.
# Outputs:
#   The usage message, written to stderr.
# Returns:
#   Always 0.
core::usage_coreos-installer() {
  cat <<USAGE >&2
Usage: coreos-installer [-s secret]... [-m mount]... [-h] [installer_arg...]

Runs coreos-installer in a container with image quay.io/coreos/coreos-installer:release.

Options:
    -s secret  podman secret spec passed verbatim to \`podman run --secret\`
               (e.g. "my-key,type=mount,target=/data/my-key"). May be specified multiple times.
    -m mount   podman volume mount spec passed verbatim to \`podman run --mount\`.
               May be specified multiple times.
    -h         Print this usage message and exit.

Remaining arguments are passed through to the coreos-installer container.

Environment:
    PODMAN_LOG_LEVEL       podman run log level. (default: warn)
USAGE
}

# core::coreos-installer()
#
# Runs coreos-installer in a container with image
# quay.io/coreos/coreos-installer:release.
#
# Globals:
#   PODMAN_LOG_LEVEL  podman run log level (default: warn).
# Arguments:
#   -s <spec>  podman secret spec passed verbatim to `podman run --secret`
#              (e.g. "my-key,type=mount,target=/data/my-key"). Repeatable.
#   -m <spec>  podman volume mount spec passed verbatim to `podman run
#              --mount`. Repeatable.
#   -h         Print usage and exit.
#   $@         Remaining args are passed to the coreos-installer container.
# Outputs:
#   Whatever the containerized coreos-installer writes.
# Returns:
#   The exit status of `podman run`.
core::coreos-installer() {
  _log_entry_debug() {
    if declare -f log_debug >/dev/null 2>&1; then
      log_debug "$*"
    fi
    return 0
  }
  _log_entry_debug "Starting ${FUNCNAME[0]}($(IFS=' '; echo "$*"))"

  _log_entry_error() {
    if declare -f log_error >/dev/null 2>&1; then
      log_error "$*"
    else
      echo "$*" 1>&2
    fi
    return 0
  }

  _log_entry_sensitive() {
    if declare -f log_sensitive >/dev/null 2>&1; then
      log_sensitive "$*"
    fi
    return 0
  }

  local -a secrets=() mounts=()
  local -i OPTIND=1
  local opt
  # TODO add option for mounting container environment variables
  # Reference hack/vendor/bashkit/local/bin/envsubst
  while getopts ':s:m:h' opt; do
    case "${opt}" in
      s) secrets+=("${OPTARG}"); ;;
      m) mounts+=("${OPTARG}"); ;;
      h) core::usage_coreos-installer; return 0 ;;
      :)
        core::usage_coreos-installer
        _log_entry_error "${FUNCNAME[0]}(-${OPTARG}) operand is required."
        core::print_stack_trace
        return 1
        ;;
      ?)
        core::usage_coreos-installer
        _log_entry_error "${FUNCNAME[0]}(-${OPTARG}) option is unknown"
        core::print_stack_trace
        return 1
        ;;
    esac
  done
  shift $((OPTIND - 1))
  readonly secrets mounts
  _log_entry_debug "$(declare -p secrets mounts)"

  local -a _cmd=(
    "podman"
    "run"
    "-i"
    "--rm"
    "--env=BU_*"
    "--security-opt=label=disable"
    "--volume=${PWD}:/data"
    "--workdir=/data"
  )

  if [[ -n "${PODMAN_LOG_LEVEL:-}" ]]; then
    _log_entry_debug "$(declare -p PODMAN_LOG_LEVEL)"
    _cmd+=("--log-level=${PODMAN_LOG_LEVEL}")
  fi

  local s
  for s in "${secrets[@]}"; do
    _log_entry_debug "Adding ${s} to podman secrets to be mounted."
    _cmd+=("--secret=${s}")
  done

  local m
  for m in "${mounts[@]}"; do
    _log_entry_debug "Adding mount point ${m} to be mounted."
    _cmd+=("--mount=${m}")
  done

  _log_entry_sensitive "coreos-installer options: $*"

  local -r image="quay.io/coreos/coreos-installer:release"
  _log_entry_debug "$(declare -p image)"

  _cmd+=("${image}")
  _log_entry_debug "$(declare -p _cmd)"
  _cmd+=("$@")

  "${_cmd[@]}"
}


if [[ "${__BASHKIT_LIB_CORE_LOGGER_UTILS_SOURCED:-}" != "true" ]]; then
  # shellcheck source=../lib/bashkit/core/logger-utils.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/core/logger-utils.sh"
fi

if [[ "${__BASHKIT_CORE_CONTRACT_UTILS_SOURCED:-}" != "true" ]]; then
  # shellcheck source=../lib/bashkit/core/contract-utils.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/core/contract-utils.sh"
fi

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if core::bool_is_valid "${XTRACE:-}" \
    && core::bool_is_true "${XTRACE}"; then
    set -x
  fi

  core::logger_init --name "$(basename "$0"):core::coreos-installer()"
  core::coreos-installer "$@"
fi
