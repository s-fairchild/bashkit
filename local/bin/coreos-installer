#!/bin/bash
#
# Standalone wrapper executable that runs coreos-installer in a container
# (quay.io/coreos/coreos-installer:release), forwarding options via getopts
# and remaining arguments straight through to the containerized binary.

[[ "${XTRACE:-0}" -eq 1 ]] && set -x

declare -r __vendor_bashkit_utils_coreos_installer_sourced="true"
declare -r __INSTALLER_WORKDIR="/data"

# usage_coreos-installer()
#
# Prints usage to stderr.
usage_coreos-installer() {
  cat <<USAGE >&2
Usage: coreos-installer [-s secret]... [-m mount]... [-h] [installer_arg...]

Runs coreos-installer in a container with image quay.io/coreos/coreos-installer:release.

Options:
    -s secret  podman secret spec passed verbatim to \`podman run --secret\`
               (e.g. "my-key,type=mount,target=/data/my-key"). May be specified multiple times.
    -m mount   podman volume mount spec passed verbatim to \`podman run --mount\`.
               May be specified multiple times.
    -h         Print this usage message and exit.

Remaining arguments are passed through to the coreos-installer container.

Environment:
    PODMAN_LOG_LEVEL       podman run log level. (default: warn)
    INSTALLER_VOLUME_MOUNT host directory to mount as the container workdir. (default: \$PWD)
USAGE
}

# coreos-installer()
#
# Runs coreos-installer in a container with image
# quay.io/coreos/coreos-installer:release.
#
# Globals:
#   PODMAN_LOG_LEVEL        podman run log level (default: warn).
#   INSTALLER_VOLUME_MOUNT  host directory to mount as the container workdir.
# Arguments:
#   -s <spec>  podman secret spec passed verbatim to `podman run --secret`
#              (e.g. "my-key,type=mount,target=/data/my-key"). Repeatable.
#   -m <spec>  podman volume mount spec passed verbatim to `podman run
#              --mount`. Repeatable.
#   -h         Print usage and exit.
#   $@         Remaining args are passed to the coreos-installer container.
# Outputs:
#   Whatever the containerized coreos-installer writes.
# Returns:
#   The exit status of `podman run`.
coreos-installer() {
  log_debug "Starting ${FUNCNAME[0]}($(IFS=' '; echo "$*"))"

  local -a secrets=()
  local -a mounts=()
  local opt OPTIND=1
  while getopts ':s:m:h' opt; do
    case "${opt}" in
      h) usage_coreos-installer; exit 0 ;;
      s)
        secrets+=("${OPTARG}")
        log_sensitive "secrets+=(\"${OPTARG}\")"
        ;;
      m)
        mounts+=("${OPTARG}")
        log_debug "mounts+=(\"${OPTARG}\")"
        ;;
      :)
        usage_coreos-installer
        log_fatal "-${OPTARG} ${ERROR_OPTION_REQUIRED}"
        ;;
      ?)
        usage_coreos-installer
        log_fatal "-${OPTARG} ${ERROR_OPTION_UNKNOWN}"
        ;;
    esac
  done
  shift $((OPTIND - 1))

  local -r image="quay.io/coreos/coreos-installer:release"
  local -a podman_run_options=(
    "-i"
    "--rm"
    "--env='BU_*'"
    "--security-opt=label=disable"
    "--volume=${PWD}:${__INSTALLER_WORKDIR}"
    "--workdir=${__INSTALLER_WORKDIR}"
  )
  [[ -n "${PODMAN_LOG_LEVEL:-}" ]] && podman_run_options+=("--log-level=${PODMAN_LOG_LEVEL:-warn}")

  local s
  for s in "${secrets[@]}"; do
    log_sensitive "Appending --secret=${s} to podman_run_options..."
    podman_run_options+=("--secret=${s}")
  done

  local m
  for m in "${mounts[@]}"; do
    log_debug "Appending --mount=${m} to podman_run_options..."
    podman_run_options+=("--mount=${m}")
  done

  log_debug "$(declare -p __INSTALLER_WORKDIR)"
  log_debug "$(declare -p image)"
  log_sensitive "$(declare -p podman_run_options)"
  log_sensitive "coreos-installer options: $*"

  podman run \
    "${podman_run_options[@]}" \
    "${image}" \
    "$@"
}

if [[ "${__bash_logger_adapter_sourced:-}" != "true" ]]; then
  declare __bash_logger_adapter_path="${BASH_SOURCE[0]%/*}/../../../bash-logger-adapter/adapter.sh"
  [[ -f "${__bash_logger_adapter_path}" ]] || { printf '%s\n' "failed to find file: ${__bash_logger_adapter_path}" >&2; exit 1; }
  # shellcheck source=../../../bash-logger-adapter/adapter.sh
  . "${__bash_logger_adapter_path}"
  unset __bash_logger_adapter_path
fi

if [[ "${__vendor_bashkit_local_lib_bashkit_options_operands_utils_sourced:-}" != "true" ]]; then
  declare __vendor_bashkit_local_lib_bashkit_options_operands_utils="${BASH_SOURCE[0]%/*}/../lib/bashkit/options-operands-utils.sh"
  [[ -f "${__vendor_bashkit_local_lib_bashkit_options_operands_utils}" ]] || { printf '%s\n' "failed to find file: ${__vendor_bashkit_local_lib_bashkit_options_operands_utils}" >&2; exit 1; }
  # shellcheck source=../lib/bashkit/options-operands-utils.sh
  . "${__vendor_bashkit_local_lib_bashkit_options_operands_utils}"
  unset __vendor_bashkit_local_lib_bashkit_options_operands_utils
fi

coreos-installer "$@"
