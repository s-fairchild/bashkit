# shellcheck shell=bash
#
# Standalone wrapper executable that runs envsubst in a container
# (docker.io/steve51516/envsubst:latest), forwarding options via getopts and
# remaining arguments straight through to the containerized binary.

readonly __BASHKIT_BIN_ENVSUBST_SOURCED="true"

# core::usage_envsubst()
#
# Prints usage to stderr.
#
# Globals:
#   None.
# Arguments:
#   None.
# Outputs:
#   The usage message, written to stderr.
# Returns:
#   Always 0.
core::usage_envsubst() {
  cat <<USAGE >&2
Usage: envsubst [-s secret]... [-e name=value]... [-h] [envsubst_arg...]

Runs envsubst in a container with image docker.io/steve51516/envsubst:latest.

Options:
    -s secret      podman secret name mounted into the container as a
                    type=env secret. May be specified multiple times.
    -e name=value  Additional environment variable passed to the container.
                    Double quotes around the value (if any) are stripped.
                    May be specified multiple times.
    -h             Print this usage message and exit.

Remaining arguments are passed through to the envsubst container.

Environment:
    PODMAN_LOG_LEVEL  podman run log level. (default: warn)

All ENVSUBST_* environment variables are forwarded to the container
automatically.
USAGE
}

# core::envsubst()
#
# Thin podman wrapper around docker.io/steve51516/envsubst:latest. Forwards
# all ENVSUBST_* environment variables and mounts every -s secret as a
# podman type=env secret.
#
# Globals:
#   PODMAN_LOG_LEVEL  Optional. podman run log level. (default: warn)
# Arguments:
#   -s <secret>       podman secret name to mount as a type=env secret.
#                     Repeatable.
#   -e <name=value>   Additional environment variable to pass to the
#                     container. Repeatable.
#   -h                Print usage and exit.
#   $@                Remaining args are passed to the envsubst container.
# Outputs:
#   Writes the containerized envsubst's stdout/stderr.
# Returns:
#   The container's exit status.
core::envsubst() {
  _log_entry_debug() {
    if declare -f log_debug >/dev/null 2>&1; then
      log_debug "$*"
    fi

    return 0
  }
  _log_entry_debug "Starting ${FUNCNAME[0]}($(IFS=' '; echo "$*"))"

  _log_entry_error() {
    local msg="${1:-}"
    if declare -f log_error >/dev/null 2>&1; then
      log_error "${msg}"
    else
      echo "${msg}" 1>&2
    fi
  }
  _log_entry_sensitive() {
    if declare -f log_sensitive >/dev/null 2>&1; then
      log_sensitive "$*"
    fi
    return 0
  }

  local -a podman_run_options=() podman_env_options=()
  local -i OPTIND=1
  local opt
  while getopts ':s:e:h' opt; do
    case "${opt}" in
      s) podman_run_options+=("--secret=${OPTARG},type=env") ;;
      e) podman_env_options+=("${OPTARG}") ;;
      h) core::usage_envsubst; return 0;;
      :)
        core::usage_envsubst
        _log_entry_error "${FUNCNAME[0]}(-${OPTARG}) operand is required."
        core::print_stack_trace
        return 1
        ;;
      ?)
        core::usage_envsubst
        _log_entry_error "${FUNCNAME[0]}(-${OPTARG}) option is unknown."
        core::print_stack_trace
        return 1
        ;;
    esac
  done
  shift $((OPTIND - 1))
  readonly podman_env_options
  _log_entry_sensitive "$(declare -p podman_env_options)"

  local -a _cmd=(
    "podman"
    "run"
    "-i"
    "--rm"
    "--env=ENVSUBST_*"
  )

  if [[ -n "${PODMAN_LOG_LEVEL:-}" ]]; then
    _log_entry_debug "$(declare -p PODMAN_LOG_LEVEL)"
    _cmd+=("--log-level=${PODMAN_LOG_LEVEL}")
  fi

  local -r image="docker.io/steve51516/envsubst:latest"
  _log_entry_debug "$(declare -p image)"
  _log_entry_debug "$(declare -p _cmd)"

  # Secret specs and --env values may be sensitive, so they are added after
  # the debug line above.
  _cmd+=("${podman_run_options[@]}")

  # Not read-only: both are reassigned for each -e.
  local e identifier value
  for e in "${podman_env_options[@]}"; do
    identifier="$(cut -d '=' -f 1 <<< "${e}")"

    if ! core::is_valid_var_name "${identifier}"; then
      _log_entry_error "Variable name identifier is invalid: ${identifier}"
      core::print_stack_trace
      return 1
    fi

    value="$(cut -d '=' -f 2 <<< "${e}")"
    _log_entry_debug "Parsed value from --env=value of environment variable: ${identifier}"
    _log_entry_sensitive "${identifier}=${value}"

    # Strip double quotes (if any) so they are not added to the value.
    value="$(tr -d '"' <<< "${value}")"
    _log_entry_debug "Stripped quotes from value of environment variable: ${identifier}"
    _log_entry_sensitive "${identifier}=${value}"

    _cmd+=("--env=${identifier}=${value}")
  done

  # After every podman option: what follows the image is passed to envsubst
  # inside the container.
  _cmd+=("${image}")

  _log_entry_sensitive "envsubst options: $*"
  _cmd+=("$@")

  "${_cmd[@]}"
}

if [[ "${__BASHKIT_LIB_CORE_LOGGER_UTILS_SOURCED:-}" != "true" ]]; then
  # shellcheck source=../lib/bashkit/core/logger-utils.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/core/logger-utils.sh"
fi

if [[ "${__BASHKIT_CORE_CONTRACT_UTILS_SOURCED:-}" != "true" ]]; then
  # shellcheck source=../lib/bashkit/core/contract-utils.sh
  . "${BASH_SOURCE[0]%/*}/../lib/bashkit/core/contract-utils.sh"
fi

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if core::bool_is_valid "${XTRACE:-}" \
    && core::bool_is_true "${XTRACE}"; then
    set -x
  fi

  core::logger_init --name "$(basename "${0}"):core::envsubst()"
  core::envsubst "$@"
fi
