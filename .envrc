# shellcheck shell=bash

export BASHKIT_ENV="${BASHKIT_ENV:-dev}"
# export BASHKIT_VERBOSE="${BASHKIT_VERBOSE:-false}"
# export BASHKIT_QUIET="${BASHKIT_QUIET:-false}"
# export BASHKIT_LEVEL="${BASHKIT_LEVEL:-info}"
# export BASHKIT_LOG_FILE="${BASHKIT_LOG_FILE:-}"
# export BASHKIT_LOG_CONFIG="${BASHKIT_LOG_CONFIG:-}"
# export BASHKIT_LOG_CONFIG_DIR="${BASHKIT_LOG_CONFIG_DIR:-}"

# direnv runs this from the repo root, so ${PWD} is this checkout. .log/ is
# git-ignored apart from its own .gitignore.
export BASHKIT_LOG_FILE="${BASHKIT_LOG_FILE:-${PWD}/.log/${BASHKIT_ENV}.log}"

# GVM (Go Version Manager)
if [[ -x "${HOME}/.local/bin/gvm" ]]; then
  gvm env
fi

