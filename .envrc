# shellcheck shell=bash

export BASHKIT_ENV="${BASHKIT_ENV:-dev}"

# Optional overrides; see README.md "Logging configuration". BASHKIT_VERBOSE
# and BASHKIT_QUIET take true/false, yes/no, on/off, or 1/0.
# export BASHKIT_VERBOSE="${BASHKIT_VERBOSE:-false}"
# export BASHKIT_QUIET="${BASHKIT_QUIET:-false}"
# export BASHKIT_LEVEL="${BASHKIT_LEVEL:-info}"
# export BASHKIT_LOG_FILE="${BASHKIT_LOG_FILE:-}"   # instead of BASHKIT_LOG_DIR
# export BASHKIT_LOG_CONFIG="${BASHKIT_LOG_CONFIG:-}"
# export BASHKIT_LOG_CONFIG_DIR="${BASHKIT_LOG_CONFIG_DIR:-}"

# direnv runs this from the repo root, so ${PWD} is this checkout. .log/ is
# git-ignored apart from its own .gitignore.
#
# Only the directory is set here. core::logger_init adds ${BASHKIT_ENV}.log
# when a script starts, so `BASHKIT_ENV=test ./script` logs to .log/test.log.
# A file name built here would be fixed at the moment direnv loads this file.
export BASHKIT_LOG_DIR="${BASHKIT_LOG_DIR:-${PWD}/.log}"

# GVM (Go Version Manager)
if [[ -x "${HOME}/.local/bin/gvm" ]]; then
  gvm env
fi

